# Server Settings
PORT=3000
NODE_ENV=development

# Database Settings
# Defaults to a local "data/database.sqlite" file in the workspace
DATABASE_URL=

# Cron Schedule Settings
# Runs every 15 minutes by default: */15 * * * *
# For testing, you can change this to run every minute: */1 * * * *
CRON_INTERVAL=*/15 * * * *

# AI Service Settings
# Set your Gemini API key from Google AI Studio. 
# If left blank, the server automatically falls back to the dynamic Mock LLM Engine.
GEMINI_API_KEY=
